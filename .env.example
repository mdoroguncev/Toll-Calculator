# Kafka (receiver, calculator)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=obuData

# OBU simulator
OBU_WS_URL=ws://127.0.0.1:30000/ws

# Data receiver
RECEIVER_ADDR=:30000

# Distance calculator
CALC_KAFKA_GROUP=distance-calculator

# Aggregator
AGG_HTTP_ENDPOINT=:4000
AGG_GRPC_ENDPOINT=:3001

# Aggregator storage: memory | postgres
AGG_STORE_TYPE=postgres
AGG_DB_DSN=postgres://toll:toll@localhost:5433/toll?sslmode=disable

# Aggregator address for its clients (calculator, gateway)
AGG_HTTP_URL=http://127.0.0.1:4000
AGG_GRPC_URL=127.0.0.1:3001

# Gateway
GATEWAY_ADDR=:6000
