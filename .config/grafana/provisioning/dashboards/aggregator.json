{
  "uid": "aggregator",
  "title": "Aggregator",
  "tags": [
    "tolling"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aggregator_request_counter_aggregate[1m])",
          "legendFormat": "aggregate"
        },
        {
          "refId": "B",
          "expr": "rate(aggregator_request_counter_calculate[1m])",
          "legendFormat": "calculate"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aggregator_error_counter_aggregate[1m])",
          "legendFormat": "aggregate"
        },
        {
          "refId": "B",
          "expr": "rate(aggregator_error_counter_calculate[1m])",
          "legendFormat": "calculate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Average latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aggregator_request_latency_aggregate_sum[1m]) / rate(aggregator_request_latency_aggregate_count[1m])",
          "legendFormat": "aggregate"
        },
        {
          "refId": "B",
          "expr": "rate(aggregator_request_latency_calculate_sum[1m]) / rate(aggregator_request_latency_calculate_count[1m])",
          "legendFormat": "calculate"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(aggregator_request_latency_aggregate_bucket[1m]))",
          "legendFormat": "aggregate"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, rate(aggregator_request_latency_calculate_bucket[1m]))",
          "legendFormat": "calculate"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"aggregator\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Heap in use",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_inuse_bytes{job=\"aggregator\"}",
          "legendFormat": "heap"
        }
      ]
    }
  ]
}